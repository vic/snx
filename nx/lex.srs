// snx lexer (bead vic-r5p.2): Nix 2.34.8 src/libexpr/lexer.l as a function. flex takes the longest match and, on a
// tie, the earlier rule; st is lexer.l's start-condition stack (Coll.Nil = INITIAL). A `throw` in lexer.l is
// an Nx.TBad token at its CUR_POS (last token); a rule that returns EOF (or flex reaching EOF) is Nx.TEof whose p is where Nix reports
// "unexpected end of file": the end offset of the last lexeme (parser.y:127).

enum Nx.LxState:
  case Nx.LxDef            // DEFAULT, pushed by { and ${
  case Nx.LxStr            // STRING
  case Nx.LxInd            // IND_STRING
  case Nx.LxPath           // INPATH
  case Nx.LxPathSlash      // INPATH_SLASH: the last path piece ends in /

// the DEFAULT rules of lexer.l, in file order (the order breaks ties)
enum Nx.LxRule:
  case Nx.LxAny            // {ANY}: the byte itself, the last rule
  case Nx.LxOp             // ... and the two-byte operators
  case Nx.LxId
  case Nx.LxInt
  case Nx.LxFloat
  case Nx.LxDollar
  case Nx.LxClose
  case Nx.LxOpen
  case Nx.LxQuote
  case Nx.LxIndOpen
  case Nx.LxSegDollar      // {PATH_SEG}\$\{ and {HPATH_START}\$\{
  case Nx.LxPathR          // {PATH} and {HPATH}
  case Nx.LxSPath
  case Nx.LxUri
  case Nx.LxSkip           // whitespace and comments

// the rule at i and the end of its match: rt/snx_rt.c Nx.lxScan (nx/rt.srs "lexer"), end * 16 + the rule's code; the
// codes tested most frequent first (ID, then {ANY}: , ; = . [ ] ( ) :)
def Nx.lxRuleOf(k: I64): Nx.LxRule =
  if k == 2 then Nx.LxId
  else if k == 0 then Nx.LxAny
  else if k == 8 then Nx.LxQuote
  else if k == 7 then Nx.LxOpen
  else if k == 6 then Nx.LxClose
  else if k == 1 then Nx.LxOp
  else if k == 5 then Nx.LxDollar
  else if k == 9 then Nx.LxIndOpen
  else if k == 11 then Nx.LxPathR
  else if k == 3 then Nx.LxInt
  else if k == 4 then Nx.LxFloat
  else if k == 10 then Nx.LxSegDollar
  else if k == 12 then Nx.LxSPath
  else if k == 13 then Nx.LxUri
  else Nx.LxSkip

def Nx.lxPop(st: Coll.List[Nx.LxState]): Coll.List[Nx.LxState] = st match
  case Coll.Nil => st
  case Coll.Cons(_, rest) => rest

def Nx.lxEnd(out: Ptr, p: I64): Ptr = Nx.tvPush(out, Nx.TEof(p))
// the lexer throws at p: the tokens before it stay, so a syntax error the parser meets first is reported first
def Nx.lxBad(out: Ptr, p: I64): Ptr = Nx.tvPush(out, Nx.TBad(p))

// the tokens pushed into v (rt/snx_rt.c token vector, in order) as one list, built from the last; v is freed
def Nx.lxDone(v: Ptr): Nx.LexResult =
  val ts = Nx.lxList(v, Nx.tvLen(v) - 1, Coll.Nil)
  Nx.tvFree(v)
  Nx.Toks(ts)

def Nx.lxList(v: Ptr, i: I64, acc: Coll.List[Nx.Tok]): Coll.List[Nx.Tok] = if i < 0 then acc else Nx.lxList(v, i - 1, Coll.Cons(Nx.tvAt[Nx.Tok](v, i), acc))

def Nx.tokPos(t: Nx.Tok): I64 = t match
  case Nx.TId(_, p) => p
  case Nx.TInt(_, p) => p
  case Nx.TFloat(_, p) => p
  case Nx.TUri(_, p) => p
  case Nx.TStrOpen(_, p) => p
  case Nx.TStrPart(_, p) => p
  case Nx.TStrClose(p) => p
  case Nx.TDollarCurly(p) => p
  case Nx.TPathOpen(p) => p
  case Nx.TPathPart(_, p) => p
  case Nx.TPathClose(p) => p
  case Nx.TSPath(_, p) => p
  case Nx.TOp(_, p) => p
  case Nx.TEof(p) => p
  case Nx.TBad(p) => p

// strtod sets ERANGE (lexer.l {FLOAT}: "invalid float") on overflow to inf and on underflow to 0 or a subnormal
def Nx.lxFloatBad(t: Str, bits: I64): Bool = bits == 9218868437227405312 || (bits < 4503599627370496 && Nx.lxNonZero(t, 0))
def Nx.lxNonZero(t: Str, i: I64): Bool =
  val c = Str.at(t, i)
  if c == -1 || c == 'e' || c == 'E' then false
  else if c >= '1' && c <= '9' then true
  else Nx.lxNonZero(t, i + 1)

def Nx.lxPathState(s: Str, e: I64): Nx.LxState = if Str.at(s, e - 1) == '/' then Nx.LxPathSlash else Nx.LxPath

// <STRING> and <IND_STRING> runs, the plain-run and NUL checks: rt/snx_rt.c (nx/rt.srs "lexer")

// unescapeStr (lexer.l:46): \n \r \t, \x = x, a bare CR or CR LF = LF
def Nx.lxUnescape(s: Str, i: I64, e: I64): Str = Nx.lxUnesc(s, i, e, i, "")
def Nx.lxUnesc(s: Str, i: I64, e: I64, from: I64, acc: Str): Str =
  if i >= e then Nx.cat(acc, Str.slice(s, from, e))
  else if Str.at(s, i) == '\\' then Nx.lxUnesc(s, i + 2, e, i + 2, Nx.cat(Nx.cat(acc, Str.slice(s, from, i)), Nx.byte(Nx.lxEsc(Str.at(s, i + 1)))))
  else if Str.at(s, i) == 13 then Nx.lxUnesc(s, Nx.lxCrEnd(s, i, e), e, Nx.lxCrEnd(s, i, e), Nx.cat(Nx.cat(acc, Str.slice(s, from, i)), "\n"))
  else Nx.lxUnesc(s, i + 1, e, from, acc)
def Nx.lxCrEnd(s: Str, i: I64, e: I64): I64 = if i + 1 < e && Str.at(s, i + 1) == '\n' then i + 2 else i + 1
def Nx.lxEsc(c: I64): I64 = if c == 'n' then 10 else if c == 'r' then 13 else if c == 't' then 9 else c

// unescapeStr's NUL check (forceNoNullByte): an escaped byte is not checked
def Nx.lxRawNul(s: Str, i: I64, e: I64): Bool =
  if i >= e then false
  else if Str.at(s, i) == 0 then true
  else if Str.at(s, i) == '\\' then Nx.lxRawNul(s, i + 2, e)
  else Nx.lxRawNul(s, i + 1, e)

// <INPATH,INPATH_SLASH>: ${ ; {PATH}|{PATH_SEG}|{PATH_CHAR}+ ; else INPATH ends the path (PATH_END, the byte is lexed
// again below) and INPATH_SLASH throws "path has a trailing slash". lb = begin of the last lexeme (a path piece or
// }), pb = begin of the one before it. An <<EOF>> rule runs no adjustLoc, so unstash restores the location of the
// lexeme before the last one: PATH_END at pb, and the EOF after it ends where that lexeme ends (lb). The piece:
// rt/snx_rt.c Nx.lxPathPieceEnd

def Nx.lxTop(st: Coll.List[Nx.LxState]): Nx.LxState = st match
  case Coll.Nil => Nx.LxDef
  case Coll.Cons(top, _) => top

// one lexeme from i in the state on top of st, then the rest: one self tail call (a C loop), nothing allocated but
// tokens and stack cells. lb = begin of the last lexeme, pb = the one before it; a lexeme from i makes them (i, lb).
def Nx.lxGo(s: Str, n: I64, i: I64, st: Coll.List[Nx.LxState], out: Ptr, lb: I64, pb: I64): Ptr =
  Nx.lxTop(st) match
    case Nx.LxDef =>
      // the whitespace and comments from i end at j (rt/snx_rt.c, one call for the whole run); then the lexeme at j.
      // A lexeme passes pb = the begin of the lexeme before it, which INPATH alone reads: only a path or } (back into
      // INPATH) computes it (Nx.lxLastSkip), the others pass lb, never read
      val j = Nx.lxSkip(s, i)
      if j >= n then Nx.lxEnd(out, n)
      else
        val k = Nx.lxScan(s, j)
        val ku = U64.ofI64(k)
        val e = I64.ofU64(ku >> 4)
        val r = Nx.lxRuleOf(I64.ofU64(ku & U64.ofI64(15)))
        val t = Str.slice(s, j, e)
        r match
          case Nx.LxAny =>
            // {ANY} returns the byte; a NUL byte is token 0 = end of file
            if Str.at(s, j) == 0 then Nx.lxEnd(out, j + 1)
            else Nx.lxGo(s, n, e, st, Nx.tvPush(out, Nx.TOp(t, j)), j, lb)
          case Nx.LxOp => Nx.lxGo(s, n, e, st, Nx.tvPush(out, Nx.TOp(t, j)), j, lb)
          case Nx.LxId => Nx.lxGo(s, n, e, st, Nx.tvPush(out, Nx.TId(t, j)), j, lb)
          case Nx.LxInt =>
            if Nx.intOverflows(t) then Nx.lxBad(out, j)
            else Nx.lxGo(s, n, e, st, Nx.tvPush(out, Nx.TInt(Nx.intValue(t), j)), j, lb)
          case Nx.LxFloat =>
            val bits = Nx.floatBits(t)
            if Nx.lxFloatBad(t, bits) then Nx.lxBad(out, j)
            else Nx.lxGo(s, n, e, st, Nx.tvPush(out, Nx.TFloat(bits, j)), j, lb)
          case Nx.LxDollar => Nx.lxGo(s, n, e, Coll.Cons(Nx.LxDef, st), Nx.tvPush(out, Nx.TDollarCurly(j)), j, lb)
          // } pops unless the stack is at INITIAL
          case Nx.LxClose => Nx.lxGo(s, n, e, Nx.lxPop(st), Nx.tvPush(out, Nx.TOp(t, j)), j, Nx.lxLastSkip(s, i, j, lb))
          case Nx.LxOpen => Nx.lxGo(s, n, e, Coll.Cons(Nx.LxDef, st), Nx.tvPush(out, Nx.TOp(t, j)), j, lb)
          case Nx.LxQuote => Nx.lxGo(s, n, e, Coll.Cons(Nx.LxStr, st), Nx.tvPush(out, Nx.TStrOpen(false, j)), j, lb)
          case Nx.LxIndOpen => Nx.lxGo(s, n, e, Coll.Cons(Nx.LxInd, st), Nx.tvPush(out, Nx.TStrOpen(true, j)), j, lb)
          // PATH_START re-lexes the text before ${ as PATH_SEG or HPATH_START, then INPATH_SLASH
          case Nx.LxSegDollar => Nx.lxGo(s, n, e - 2, Coll.Cons(Nx.LxPathSlash, st), Nx.tvPush(Nx.tvPush(out, Nx.TPathOpen(j)), Nx.TPathPart(Str.slice(s, j, e - 2), j)), j, Nx.lxLastSkip(s, i, j, lb))
          case Nx.LxPathR => Nx.lxGo(s, n, e, Coll.Cons(Nx.lxPathState(s, e), st), Nx.tvPush(Nx.tvPush(out, Nx.TPathOpen(j)), Nx.TPathPart(t, j)), j, Nx.lxLastSkip(s, i, j, lb))
          case Nx.LxSPath => Nx.lxGo(s, n, e, st, Nx.tvPush(out, Nx.TSPath(Str.slice(s, j + 1, e - 1), j)), j, lb)
          case Nx.LxUri => Nx.lxGo(s, n, e, st, Nx.tvPush(out, Nx.TUri(t, j)), j, lb)
          // Nx.lxSkip left none: kept for a total match
          case Nx.LxSkip => Nx.lxGo(s, n, e, st, out, j, lb)
    case Nx.LxStr =>
      val c = Str.at(s, i)
      if c == '"' then Nx.lxGo(s, n, i + 1, Nx.lxPop(st), Nx.tvPush(out, Nx.TStrClose(i)), i, lb)
      else if c == '$' && Str.at(s, i + 1) == '{' then Nx.lxGo(s, n, i + 2, Coll.Cons(Nx.LxDef, st), Nx.tvPush(out, Nx.TDollarCurly(i)), i, lb)
      else
        val k = Nx.lxStrPart(s, i)
        val e = k / 2
        // <STRING>\$|\\|\$\\ returns EOF; so does flex at the end of input
        if e == i then Nx.lxEnd(out, n)
        else if k % 2 == 0 then Nx.lxGo(s, n, e, st, Nx.tvPush(out, Nx.TStrPart(Str.slice(s, i, e), i)), i, lb)
        else if Nx.lxRawNul(s, i, e) then Nx.lxBad(out, i)
        else Nx.lxGo(s, n, e, st, Nx.tvPush(out, Nx.TStrPart(Nx.lxUnescape(s, i, e), i)), i, lb)
    case Nx.LxInd =>
      val c = Str.at(s, i)
      val d = Str.at(s, i + 2)
      val e = Nx.lxIndRun(s, i)
      // at '': ''$ is $, ''' is '', ''\{ANY} is the unescaped byte, else '' closes
      if c == '\'' && Str.at(s, i + 1) == '\'' then
        if d == '$' then Nx.lxGo(s, n, i + 3, st, Nx.tvPush(out, Nx.TStrPart("$", i)), i, lb)
        else if d == '\'' then Nx.lxGo(s, n, i + 3, st, Nx.tvPush(out, Nx.TStrPart("''", i)), i, lb)
        else if d == '\\' && Str.at(s, i + 3) != -1 then Nx.lxGo(s, n, i + 4, st, Nx.tvPush(out, Nx.TStrPart(Nx.lxUnescape(s, i + 2, i + 4), i)), i, lb)
        else Nx.lxGo(s, n, i + 2, Nx.lxPop(st), Nx.tvPush(out, Nx.TStrClose(i)), i, lb)
      else if c == '$' && Str.at(s, i + 1) == '{' then Nx.lxGo(s, n, i + 2, Coll.Cons(Nx.LxDef, st), Nx.tvPush(out, Nx.TDollarCurly(i)), i, lb)
      else if e > i && Nx.lxAnyNul(s, i, e) then Nx.lxBad(out, i)
      else if e > i then Nx.lxGo(s, n, e, st, Nx.tvPush(out, Nx.TStrPart(Str.slice(s, i, e), i)), i, lb)
      // <IND_STRING>\$ and <IND_STRING>\' : a lone $ or ' is its own piece
      else if c == '$' || c == '\'' then Nx.lxGo(s, n, i + 1, st, Nx.tvPush(out, Nx.TStrPart(Nx.byte(c), i)), i, lb)
      else Nx.lxEnd(out, n)
    case Nx.LxPath =>
      val c = Str.at(s, i)
      val e = Nx.lxPathPieceEnd(s, i)
      if c == '$' && Str.at(s, i + 1) == '{' then Nx.lxGo(s, n, i + 2, Coll.Cons(Nx.LxDef, Coll.Cons(Nx.LxPath, Nx.lxPop(st))), Nx.tvPush(out, Nx.TDollarCurly(i)), i, lb)
      else if e > i then Nx.lxGo(s, n, e, Coll.Cons(Nx.lxPathState(s, e), Nx.lxPop(st)), Nx.tvPush(out, Nx.TPathPart(Str.slice(s, i, e), i)), i, lb)
      else if i >= n then Nx.lxEnd(Nx.tvPush(out, Nx.TPathClose(pb)), lb)
      else Nx.lxGo(s, n, i, Nx.lxPop(st), Nx.tvPush(out, Nx.TPathClose(lb)), lb, pb)
    case Nx.LxPathSlash =>
      val c = Str.at(s, i)
      val e = Nx.lxPathPieceEnd(s, i)
      if c == '$' && Str.at(s, i + 1) == '{' then Nx.lxGo(s, n, i + 2, Coll.Cons(Nx.LxDef, Coll.Cons(Nx.LxPath, Nx.lxPop(st))), Nx.tvPush(out, Nx.TDollarCurly(i)), i, lb)
      else if e > i then Nx.lxGo(s, n, e, Coll.Cons(Nx.lxPathState(s, e), Nx.lxPop(st)), Nx.tvPush(out, Nx.TPathPart(Str.slice(s, i, e), i)), i, lb)
      else if i >= n then Nx.lxBad(out, lb)
      else Nx.lxBad(out, i)

def Nx.lex(src: Str): Nx.LexResult = Nx.lxDone(Nx.lexVec(src))

// the tokens in a token vector (rt/snx_rt.c), in order, the last an Nx.TEof or Nx.TBad: the parser reads them by index
def Nx.lexVec(src: Str): Ptr = Nx.lxGo(src, Str.len(src), 0, Coll.Nil, Nx.tvNew(), 0, 0)

// one line, no newline: <kind> <p> [<payload>]; payload bytes escaped \" \\ \n, \xHH below 0x20 and above 0x7e
def Nx.printTok(t: Nx.Tok): Unit = t match
  case Nx.TId(s, p) => Nx.lxShow("id ", p, s)
  case Nx.TInt(v, p) => Nx.lxShowInt(p, v)
  case Nx.TFloat(b, p) => Nx.lxShow("float ", p, Nx.hex64(b))
  case Nx.TUri(s, p) => Nx.lxShow("uri ", p, s)
  case Nx.TStrOpen(ind, p) => Nx.lxShowOpen(p, if ind then " ''" else " \"")
  case Nx.TStrPart(s, p) => Nx.lxShow("str-part ", p, s)
  case Nx.TStrClose(p) => Nx.lxShowP("str-close ", p)
  case Nx.TDollarCurly(p) => Nx.lxShowP("dollar-curly ", p)
  case Nx.TPathOpen(p) => Nx.lxShowP("path-open ", p)
  case Nx.TPathPart(s, p) => Nx.lxShow("path-part ", p, s)
  case Nx.TPathClose(p) => Nx.lxShowP("path-close ", p)
  case Nx.TSPath(s, p) => Nx.lxShow("spath ", p, s)
  case Nx.TOp(s, p) => Nx.lxShow("op ", p, s)
  case Nx.TEof(p) => Nx.lxShowP("eof ", p)
  case Nx.TBad(p) => Nx.lxShowP("error ", p)

def Nx.lxShowP(k: Str, p: I64): Unit =
  Console.print(k)
  Console.printI64(p)

def Nx.lxShow(k: Str, p: I64, s: Str): Unit =
  Nx.lxShowP(k, p)
  Console.print(" ")
  Nx.lxPrintEsc(s, 0)

def Nx.lxShowOpen(p: I64, q: Str): Unit =
  Nx.lxShowP("str-open ", p)
  Console.print(q)

def Nx.lxShowInt(p: I64, v: I64): Unit =
  Nx.lxShowP("int ", p)
  Console.print(" ")
  Console.printI64(v)

def Nx.lxPrintEsc(s: Str, i: I64): Unit =
  val c = Str.at(s, i)
  if c == -1 then ()
  else
    Nx.lxPrintByte(c)
    Nx.lxPrintEsc(s, i + 1)

def Nx.lxPrintByte(c: I64): Unit =
  if c == '"' then Console.print("\\\"")
  else if c == '\\' then Console.print("\\\\")
  else if c == '\n' then Console.print("\\n")
  else if c < 32 || c > 126 then Nx.lxPrintHex(c)
  else Console.printChar(c)

def Nx.lxPrintHex(c: I64): Unit =
  Console.print("\\x")
  Console.print(Str.slice(Nx.hex64(c), 14, 16))
