// snx scope resolution (vic/notes/20261110T1400--eval-core-design__design_eval.md "variable resolution order"):
// Nx.Expr -> Nx.Code. A variable is, in order: a lexical binding (let, rec, lambda; with frames skipped, nixexpr.cc:326-342),
// a base env name (lexical too, eval.cc:3181), the nearest enclosing with (nixexpr.cc:343-348), else "undefined variable"
// (nixexpr.cc:343-344). Each scope level is one run-time frame, so a level's count is the frame walk.

enum Nx.CompileResult:
  case Nx.Compiled(c: Nx.Code)
  case Nx.Undefined(p: I64, name: Str)

// one compile-time frame: n names sorted by symbol id with their slots, a with frame, or a frame with no visible names
enum Nx.Sc:
  case Nx.ScLex(n: I64, syms: Ptr, slots: Ptr)
  case Nx.ScWith
  case Nx.ScAnon

// the file, its text (for __curPos), the first undefined variable ([set, offset, symbol]) and the base env
enum Nx.Cx:
  case Nx.Cx(file: Str, src: Str, undef: Ptr, base: Nx.Val)

def Nx.compile(e: Nx.Expr, file: Str, src: Str): Nx.CompileResult = Nx.compileIn(e, file, src, Coll.Nil)

// sc = the scope levels the file starts in (scopedImport: the names of its set)
def Nx.compileIn(e: Nx.Expr, file: Str, src: Str, sc: Coll.List[Nx.Sc]): Nx.CompileResult =
  val u = Nx.arrNew(3)
  Nx.aseti(u, 0, 0)
  val c = Nx.cp(e, sc, Nx.Cx(file, src, u, Nx.baseEnv()))
  if Nx.ageti(u, 0) == 1 then Nx.Undefined(Nx.ageti(u, 1), Nx.symName(Nx.ageti(u, 2))) else Nx.Compiled(c)

// a literal: its value, and one cell of it for every lazy use (a forced cell is never written again)
def Nx.konst(v: Nx.Val): Nx.Code = Nx.CConst(v, Nx.cell(v))

def Nx.cp(e: Nx.Expr, sc: Coll.List[Nx.Sc], cx: Nx.Cx): Nx.Code = e match
  case Nx.EInt(_, v) => Nx.konst(Nx.VInt(v))
  case Nx.EFloat(_, b) => Nx.konst(Nx.VFloat(b))
  case Nx.EStr(_, s) => Nx.konst(Nx.VStr(s, Coll.Nil))
  case Nx.EPath(_, s) => Nx.konst(Nx.VPath(s))
  case Nx.EConcat(_, fs, parts) =>
    val n = Coll.length(parts)
    Nx.CConcat(fs, n, Nx.cpArr(parts, sc, cx, Nx.arrNew(n), 0))
  case Nx.EList(_, xs) =>
    val n = Coll.length(xs)
    Nx.CList(n, Nx.cpArr(xs, sc, cx, Nx.arrNew(n), 0))
  case Nx.EVar(p, name) => Nx.cpVar(p, Nx.intern(name), name, sc, 0, Coll.Nil, cx)
  case Nx.ECurPos(p) => Nx.cpPos(p, cx)
  case Nx.ESelect(_, a, path, d) => Nx.CSelect(Nx.cp(a, sc, cx), Nx.cpKeys(path, sc, cx, Coll.Nil), Nx.cpOpt(d, sc, cx))
  case Nx.EHas(_, a, path) => Nx.CHas(Nx.cp(a, sc, cx), Nx.cpKeys(path, sc, cx, Coll.Nil))
  case Nx.EAttrs(_, rec, binds, dyns) => if rec then Nx.cpRec(binds, dyns, sc, cx) else Nx.cpAttrs(binds, dyns, sc, cx)
  case Nx.ELambda(_, arg, fms, body) => Nx.cpLam(arg, fms, body, sc, cx)
  case Nx.ECall(_, f, args) =>
    val n = Coll.length(args)
    Nx.cpCall(Nx.cp(f, sc, cx), n, Nx.markNum(Nx.cpArr(args, sc, cx, Nx.arrNew(n), 0), 0, n))
  case Nx.ELet(_, attrs, body) => Nx.cpLet(attrs, body, sc, cx)
  case Nx.EWith(_, a, b) => Nx.CWith(Nx.cp(a, sc, cx), Nx.cp(b, Coll.Cons(Nx.ScWith, sc), cx))
  case Nx.EIf(_, c, t, f) => Nx.CIf(Nx.cp(c, sc, cx), Nx.cp(t, sc, cx), Nx.cp(f, sc, cx))
  case Nx.EAssert(p, c, b) => Nx.cpAssert(p, Nx.cp(c, sc, cx), Nx.cp(b, sc, cx), cx)
  case Nx.ENot(_, a) => Nx.CNot(Nx.cp(a, sc, cx))
  case Nx.EEq(_, a, b) => Nx.CBin(Nx.OEq, Nx.cp(a, sc, cx), Nx.cp(b, sc, cx))
  case Nx.ENe(_, a, b) => Nx.CBin(Nx.ONe, Nx.cp(a, sc, cx), Nx.cp(b, sc, cx))
  case Nx.EAnd(_, a, b) => Nx.CAnd(Nx.cp(a, sc, cx), Nx.cp(b, sc, cx))
  case Nx.EOr(_, a, b) => Nx.COr(Nx.cp(a, sc, cx), Nx.cp(b, sc, cx))
  case Nx.EImpl(_, a, b) => Nx.CImpl(Nx.cp(a, sc, cx), Nx.cp(b, sc, cx))
  case Nx.EUpdate(_, a, b) => Nx.CBin(Nx.OUpdate, Nx.cp(a, sc, cx), Nx.cp(b, sc, cx))
  case Nx.EListConcat(_, a, b) => Nx.CBin(Nx.OListConcat, Nx.cp(a, sc, cx), Nx.cp(b, sc, cx))

// a call; a base env primop given exactly its arity runs without the function value and callN
def Nx.cpCall(f: Nx.Code, n: I64, args: Ptr): Nx.Code = Nx.fixedCell(f) match
  case Coll.Some(c) => Nx.cpPrimCall(Nx.peek(c), f, n, args)
  case Coll.None => Nx.CCall(f, n, args)

def Nx.cpPrimCall(v: Nx.Val, f: Nx.Code, n: I64, args: Ptr): Nx.Code = v match
  case Nx.VPrim(id, ar) =>
    if ar != n then Nx.CCall(f, n, args)
    else Nx.numOpOf(id) match
      case Coll.Some(op) => Nx.CNum(op, Nx.aget[Nx.Code](args, 0), Nx.aget[Nx.Code](args, 1), false)
      case Coll.None => Nx.CPrimCall(id, n, args)
  case _ => Nx.CCall(f, n, args)

// the numeric primops (Nx.CNum: both operands evaluated strictly, no thunks; Nx.thunk may run a call argument early)
def Nx.numOpOf(id: I64): Coll.Option[Nx.NumOp] = Nx.aget[Nx.Prim](Nx.aget[Ptr](Nx.globals(), Nx.gKinds()), id) match
  case Nx.PAdd => Coll.Some(Nx.NAdd)
  case Nx.PSub => Coll.Some(Nx.NSub)
  case Nx.PMul => Coll.Some(Nx.NMul)
  case Nx.PDiv => Coll.Some(Nx.NDiv)
  case Nx.PLessThan => Coll.Some(Nx.NLess)
  case Nx.PBitAnd => Coll.Some(Nx.NAnd)
  case Nx.PBitOr => Coll.Some(Nx.NOr)
  case Nx.PBitXor => Coll.Some(Nx.NXor)
  case _ => Coll.None

// args[i..n) of a call: a numeric primop among them may run at thunk time (val.srs CNum early)
def Nx.markNum(args: Ptr, i: I64, n: I64): Ptr =
  if i == n then args
  else
    Nx.aget[Nx.Code](args, i) match
      case Nx.CNum(op, a, b, _) => Nx.aset[Nx.Code](args, i, Nx.CNum(op, a, b, true))
      case _ => ()
    Nx.markNum(args, i + 1, n)

// the cell a call head always names: a base env name (lexical, so fixed) or builtins.<name> (the base sets never
// change). Only in call heads: a lazy builtins.<name> elsewhere keeps its own thunk, as Nix's (eqValues tests identity)
def Nx.fixedCell(f: Nx.Code): Coll.Option[Ptr] = f match
  case Nx.CCell(c) => Coll.Some(c)
  case Nx.CSelect(e, path, _) => e match
    case Nx.CCell(c) => path match
      case Coll.Cons(k, rest) => rest match
        case Coll.Nil => k match
          case Nx.KSym(sym) => Nx.cellIn(Nx.peek(c), sym)
          case _ => Coll.None
        case _ => Coll.None
      case _ => Coll.None
    case _ => Coll.None
  case _ => Coll.None

def Nx.cellIn(v: Nx.Val, sym: I64): Coll.Option[Ptr] = v match
  case Nx.VAttrs(n, syms, vals) =>
    val i = Nx.findSym(syms, n, sym)
    if i < n then Coll.Some(Nx.aget[Ptr](vals, i)) else Coll.None
  case Nx.VUnion(_, ls) => Nx.cellOfLeaves(ls, sym)
  case _ => Coll.None

// xs compiled into arr from slot i
def Nx.cpArr(xs: Coll.List[Nx.Expr], sc: Coll.List[Nx.Sc], cx: Nx.Cx, arr: Ptr, i: I64): Ptr = xs match
  case Coll.Nil => arr
  case Coll.Cons(h, t) =>
    Nx.aset[Nx.Code](arr, i, Nx.cp(h, sc, cx))
    Nx.cpArr(t, sc, cx, arr, i + 1)

def Nx.cpOpt(d: Coll.Option[Nx.Expr], sc: Coll.List[Nx.Sc], cx: Nx.Cx): Coll.Option[Nx.Code] = d match
  case Coll.None => Coll.None
  case Coll.Some(x) => Coll.Some(Nx.cp(x, sc, cx))

def Nx.cpKeys(path: Coll.List[Nx.Attr], sc: Coll.List[Nx.Sc], cx: Nx.Cx, acc: Coll.List[Nx.CKey]): Coll.List[Nx.CKey] = path match
  case Coll.Nil => Coll.rev(acc)
  case Coll.Cons(a, t) => a match
    case Nx.ASym(s) => Nx.cpKeys(t, sc, cx, Coll.Cons(Nx.KSym(Nx.intern(s)), acc))
    case Nx.ADyn(x) => Nx.cpKeys(t, sc, cx, Coll.Cons(Nx.KDyn(Nx.cp(x, sc, cx)), acc))

def Nx.cpPos(p: I64, cx: Nx.Cx): Nx.Code = cx match
  case Nx.Cx(file, src, _, _) => Nx.lineCol(src, p) match
    case Nx.LineCol(l, c) => Nx.CCurPos(file, l, c)

def Nx.cpAssert(p: I64, c: Nx.Code, b: Nx.Code, cx: Nx.Cx): Nx.Code = cx match
  case Nx.Cx(_, src, _, _) => Nx.CAssert(c, b, src, p)

// ---- variables ------------------------------------------------------------------------------------------------

// withs = the levels of the enclosing with frames seen so far, innermost last (reversed at the end)
def Nx.cpVar(p: I64, sym: I64, name: Str, sc: Coll.List[Nx.Sc], up: I64, withs: Coll.List[I64], cx: Nx.Cx): Nx.Code = sc match
  case Coll.Cons(s, rest) => s match
    case Nx.ScLex(n, syms, slots) =>
      val i = Nx.findSym(syms, n, sym)
      if i < n then Nx.CLocal(up, Nx.ageti(slots, i)) else Nx.cpVar(p, sym, name, rest, up + 1, withs, cx)
    case Nx.ScWith => Nx.cpVar(p, sym, name, rest, up + 1, Coll.Cons(up, withs), cx)
    case Nx.ScAnon => Nx.cpVar(p, sym, name, rest, up + 1, withs, cx)
  case Coll.Nil => cx match
    case Nx.Cx(_, _, u, base) => base match
      case Nx.VAttrs(n, syms, vals) =>
        val i = Nx.findSym(syms, n, sym)
        if i < n then Nx.CCell(Nx.aget[Ptr](vals, i)) else Nx.cpWithVar(p, sym, name, withs, u)
      case _ => Nx.cpWithVar(p, sym, name, withs, u)

def Nx.cpWithVar(p: I64, sym: I64, name: Str, withs: Coll.List[I64], u: Ptr): Nx.Code = withs match
  case Coll.Cons(_, _) => Nx.CWithVar(sym, Coll.rev(withs), name)
  case Coll.Nil =>
    if Nx.ageti(u, 0) == 0 then
      Nx.aseti(u, 0, 1)
      Nx.aseti(u, 1, p)
      Nx.aseti(u, 2, sym)
    else ()
    Nx.konst(Nx.VErr(Nx.KOther, Nx.cat("undefined variable ", name)))

// ---- bindings -------------------------------------------------------------------------------------------------

def Nx.bindName(b: Nx.Binding): Str = b match
  case Nx.Bind(n, _, _) => n
  case Nx.BInherit(n, _) => n
  case Nx.BInheritFrom(n, _, _) => n

// the n bindings as arrays sorted by symbol id: syms (I64) and the Nx.Binding of each
enum Nx.Sorted:
  case Nx.Sorted(n: I64, syms: Ptr, binds: Ptr)

def Nx.sortBinds(bs: Coll.List[Nx.Binding]): Nx.Sorted =
  val n = Coll.length(bs)
  val syms = Nx.arrNew(n)
  val arr = Nx.arrNew(n)
  Nx.fillBinds(bs, syms, arr, 0)
  Nx.sortPairs(syms, arr, n)
  Nx.Sorted(n, syms, arr)

def Nx.fillBinds(bs: Coll.List[Nx.Binding], syms: Ptr, arr: Ptr, i: I64): Unit = bs match
  case Coll.Nil => ()
  case Coll.Cons(b, t) =>
    Nx.aseti(syms, i, Nx.intern(Nx.bindName(b)))
    Nx.aset[Nx.Binding](arr, i, b)
    Nx.fillBinds(t, syms, arr, i + 1)

// a scope level whose names are the sorted syms, name i in slot i + 1
def Nx.scOfSorted(n: I64, syms: Ptr): Nx.Sc =
  val slots = Nx.arrNew(n)
  Nx.fillSlots(slots, 0, n)
  Nx.ScLex(n, syms, slots)

def Nx.fillSlots(slots: Ptr, i: I64, n: I64): Unit =
  if i < n then
    Nx.aseti(slots, i, i + 1)
    Nx.fillSlots(slots, i + 1, n)
  else ()

// the code of binding b. inner = the scope of plain values and of inherit-from sources; outer = the scope of a plain
// inherit (the enclosing one, seen from inside the new frame: chooseByKind, nixexpr.cc:425-437, eval.cc:1259-1300)
// shortcut: an inherit (e) source is evaluated once per name, not shared (Nix: one inheritFromEnv); share it when a test
// or a profile shows the cost.
def Nx.cpBind(b: Nx.Binding, inner: Coll.List[Nx.Sc], outer: Coll.List[Nx.Sc], cx: Nx.Cx): Nx.Code = b match
  case Nx.Bind(_, x, _) => Nx.cp(x, inner, cx)
  case Nx.BInherit(n, _) => Nx.cpVar(0, Nx.intern(n), n, outer, 0, Coll.Nil, cx)
  case Nx.BInheritFrom(n, from, _) => Nx.CSelect(Nx.cp(from, inner, cx), Coll.Cons(Nx.KSym(Nx.intern(n)), Coll.Nil), Coll.None)

def Nx.cpBinds(arr: Ptr, out: Ptr, i: I64, n: I64, inner: Coll.List[Nx.Sc], outer: Coll.List[Nx.Sc], cx: Nx.Cx): Ptr =
  if i < n then
    Nx.aset[Nx.Code](out, i, Nx.cpBind(Nx.aget[Nx.Binding](arr, i), inner, outer, cx))
    Nx.cpBinds(arr, out, i + 1, n, inner, outer, cx)
  else out

def Nx.cpDyns(ds: Coll.List[Nx.DynBind], sc: Coll.List[Nx.Sc], cx: Nx.Cx, acc: Coll.List[Nx.CDyn]): Coll.List[Nx.CDyn] = ds match
  case Coll.Nil => Coll.rev(acc)
  case Coll.Cons(d, t) => d match
    case Nx.DBind(k, x) => Nx.cpDyns(t, sc, cx, Coll.Cons(Nx.CDynBind(Nx.cp(k, sc, cx), Nx.cp(x, sc, cx)), acc))

// { ... }: values in the current frame
def Nx.cpAttrs(binds: Coll.List[Nx.Binding], dyns: Coll.List[Nx.DynBind], sc: Coll.List[Nx.Sc], cx: Nx.Cx): Nx.Code =
  Nx.sortBinds(binds) match
    case Nx.Sorted(n, syms, arr) => Nx.cpAttrsAt(syms, Nx.posOfBinds(cx, arr, n), Nx.CAttrs(n, syms, Nx.cpBinds(arr, Nx.arrNew(n), 0, n, sc, sc, cx), Nx.cpDyns(dyns, sc, cx, Coll.Nil)))

// rec { ... }: a new frame of the names, slot i + 1 = attribute i (the set shares the frame's cells)
def Nx.cpRec(binds: Coll.List[Nx.Binding], dyns: Coll.List[Nx.DynBind], sc: Coll.List[Nx.Sc], cx: Nx.Cx): Nx.Code =
  Nx.sortBinds(binds) match
    case Nx.Sorted(n, syms, arr) =>
      val inner = Coll.Cons(Nx.scOfSorted(n, syms), sc)
      Nx.cpAttrsAt(syms, Nx.posOfBinds(cx, arr, n), Nx.CRecAttrs(n, syms, Nx.cpBinds(arr, Nx.arrNew(n), 0, n, inner, Coll.Cons(Nx.ScAnon, sc), cx), Nx.cpDyns(dyns, inner, cx, Coll.Nil)))

// let: as rec, the body in the new frame (nixexpr.cc:505-525); a let has no dynamic attributes (the parser refuses them)
def Nx.cpLet(attrs: Nx.Expr, body: Nx.Expr, sc: Coll.List[Nx.Sc], cx: Nx.Cx): Nx.Code = attrs match
  case Nx.EAttrs(_, _, binds, _) => Nx.sortBinds(binds) match
    case Nx.Sorted(n, syms, arr) =>
      val inner = Coll.Cons(Nx.scOfSorted(n, syms), sc)
      Nx.CLet(n, Nx.cpBinds(arr, Nx.arrNew(n), 0, n, inner, Coll.Cons(Nx.ScAnon, sc), cx), Nx.cp(body, inner, cx))
  case _ => Nx.cp(body, Coll.Cons(Nx.ScAnon, sc), cx)

// ---- lambdas --------------------------------------------------------------------------------------------------

// x: body has one slot; a pattern has slot 1 = the argument (named by @ or not), slots 2.. = the formals by symbol id
// (nixexpr.cc:461-482: formals sorted, defaults and body in the new frame)
def Nx.cpLam(arg: Coll.Option[Str], fms: Coll.Option[Nx.Formals], body: Nx.Expr, sc: Coll.List[Nx.Sc], cx: Nx.Cx): Nx.Code = fms match
  case Coll.None => arg match
    case Coll.Some(x) => Nx.CLamArg(Nx.cp(body, Coll.Cons(Nx.ScLex(1, Nx.oneSym(Nx.intern(x)), Nx.oneSym(1)), sc), cx), x)
    case Coll.None => Nx.CLamArg(Nx.cp(body, Coll.Cons(Nx.ScAnon, sc), cx), "")
  case Coll.Some(f) => f match
    case Nx.Fms(ell, fs) => Nx.cpPattern(arg, ell, fs, body, sc, cx)

def Nx.oneSym(v: I64): Ptr =
  val a = Nx.arrNew(1)
  Nx.aseti(a, 0, v)
  a

def Nx.fmName(f: Nx.Formal): Str = f match
  case Nx.Fm(n, _, _) => n

def Nx.fillFormals(fs: Coll.List[Nx.Formal], syms: Ptr, arr: Ptr, i: I64): Unit = fs match
  case Coll.Nil => ()
  case Coll.Cons(f, t) =>
    Nx.aseti(syms, i, Nx.intern(Nx.fmName(f)))
    Nx.aset[Nx.Formal](arr, i, f)
    Nx.fillFormals(t, syms, arr, i + 1)

def Nx.cpPattern(arg: Coll.Option[Str], ell: Bool, fs: Coll.List[Nx.Formal], body: Nx.Expr, sc: Coll.List[Nx.Sc], cx: Nx.Cx): Nx.Code =
  val nf = Coll.length(fs)
  val syms = Nx.arrNew(nf)
  val arr = Nx.arrNew(nf)
  Nx.fillFormals(fs, syms, arr, 0)
  Nx.sortPairs(syms, arr, nf)
  // the scope: formal i in slot i + 2, the @ name in slot 1
  val n: I64 = arg match
    case Coll.Some(_) => nf + 1
    case Coll.None => nf
  val ns = Nx.arrNew(n)
  val nslot = Nx.arrNew(n)
  Nx.fmScope(syms, ns, nslot, 0, nf)
  val named: Bool = arg match
    case Coll.Some(x) =>
      Nx.aseti(ns, nf, Nx.intern(x))
      Nx.aseti(nslot, nf, 1)
      true
    case Coll.None => false
  Nx.sortPairs(ns, nslot, n)
  val inner = Coll.Cons(Nx.ScLex(n, ns, nslot), sc)
  val cfs = Nx.cpFormals(syms, arr, Nx.arrNew(nf), 0, nf, inner, cx)
  Nx.cpAttrsAt(cfs, Nx.posOfFormals(cx, arr, nf), Nx.CLam(named, nf, cfs, ell, nf + 1, Nx.cp(body, inner, cx), Nx.optStr(arg)))

// the @ name of a pattern, or ""
def Nx.optStr(o: Coll.Option[Str]): Str = o match
  case Coll.Some(x) => x
  case Coll.None => ""

def Nx.fmScope(syms: Ptr, ns: Ptr, nslot: Ptr, i: I64, nf: I64): Unit =
  if i < nf then
    Nx.aseti(ns, i, Nx.ageti(syms, i))
    Nx.aseti(nslot, i, i + 2)
    Nx.fmScope(syms, ns, nslot, i + 1, nf)
  else ()

def Nx.cpFormals(syms: Ptr, arr: Ptr, out: Ptr, i: I64, nf: I64, inner: Coll.List[Nx.Sc], cx: Nx.Cx): Ptr =
  if i < nf then
    val d: Coll.Option[Nx.Code] = Nx.aget[Nx.Formal](arr, i) match
      case Nx.Fm(_, dflt, _) => Nx.cpOpt(dflt, inner, cx)
    Nx.aset[Nx.CFormal](out, i, Nx.CFm(Nx.ageti(syms, i), d))
    Nx.cpFormals(syms, arr, out, i + 1, nf, inner, cx)
  else out

// ---- source positions of attribute names and formals (unsafeGetAttrPos) --------------------------------------------

// the record of a set or a pattern: [file cell, source cell, byte offset of name 0, ..]; kept in the table of rt/snx_fs.c
// under the address of the array of the symbols, which every evaluation of the set shares
def Nx.posRec(cx: Nx.Cx, n: I64): Ptr = cx match
  case Nx.Cx(file, src, _, _) =>
    val r = Nx.arrNew(n + 2)
    Nx.aset[Ptr](r, 0, Nx.strCell(file))
    Nx.aset[Ptr](r, 1, Nx.strCell(src))
    r

def Nx.posOfBinds(cx: Nx.Cx, arr: Ptr, n: I64): Ptr =
  val r = Nx.posRec(cx, n)
  Nx.fillBindPos(arr, r, 0, n)
  r

def Nx.fillBindPos(arr: Ptr, r: Ptr, i: I64, n: I64): Unit =
  if i < n then
    Nx.aseti(r, i + 2, Nx.bindPos(Nx.aget[Nx.Binding](arr, i)))
    Nx.fillBindPos(arr, r, i + 1, n)
  else ()

def Nx.bindPos(b: Nx.Binding): I64 = b match
  case Nx.Bind(_, _, p) => p
  case Nx.BInherit(_, p) => p
  case Nx.BInheritFrom(_, _, p) => p

def Nx.posOfFormals(cx: Nx.Cx, arr: Ptr, n: I64): Ptr =
  val r = Nx.posRec(cx, n)
  Nx.fillFormalPos(arr, r, 0, n)
  r

def Nx.fillFormalPos(arr: Ptr, r: Ptr, i: I64, n: I64): Unit =
  if i < n then
    Nx.aget[Nx.Formal](arr, i) match
      case Nx.Fm(_, _, p) => Nx.aseti(r, i + 2, p)
    Nx.fillFormalPos(arr, r, i + 1, n)
  else ()

// the code c, after its position record is registered under key
def Nx.cpAttrsAt(key: Ptr, rec: Ptr, c: Nx.Code): Nx.Code =
  Nx.posPut(key, rec)
  c
