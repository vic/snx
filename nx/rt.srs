extern def Nx.atFreeAll(): Unit

// pointer identity
def Nx.ptrEq(a: Ptr, b: Ptr): Bool = a == b

// machine words for Nix integers: two's complement wrapping arithmetic on the U64 bits, and the overflow tests of
// __builtin_{add,sub,mul}_overflow
def Nx.iMax(): I64 = 9223372036854775807
def Nx.iMin(): I64 = 0 - 9223372036854775807 - 1
def Nx.iadd(a: I64, b: I64): I64 = I64.ofU64(U64.ofI64(a) + U64.ofI64(b))
def Nx.isub(a: I64, b: I64): I64 = I64.ofU64(U64.ofI64(a) - U64.ofI64(b))
def Nx.imul(a: I64, b: I64): I64 = I64.ofU64(U64.ofI64(a) * U64.ofI64(b))
// the wrapped result r overflowed when its sign differs from the sign both a and b (a and -b) share
def Nx.addOv(a: I64, b: I64): Bool = Nx.iand(Nx.ixor(a, Nx.iadd(a, b)), Nx.ixor(b, Nx.iadd(a, b))) < 0
def Nx.subOv(a: I64, b: I64): Bool = Nx.iand(Nx.ixor(a, b), Nx.ixor(a, Nx.isub(a, b))) < 0
// the wrapped product divided by a gives b back exactly when it did not wrap; a = -1 is tested first, since
// MIN / -1 is itself an overflow
def Nx.mulOv(a: I64, b: I64): Bool =
  if a == 0 then false
  else if a == 0 - 1 then b == Nx.iMin()
  else Nx.imul(a, b) / a != b
// a / b truncated; call only with b != 0 and not (MIN, -1)
def Nx.idiv(a: I64, b: I64): I64 = a / b
// prim_bitAnd, prim_bitOr, prim_bitXor
def Nx.iand(a: I64, b: I64): I64 = I64.ofU64(U64.ofI64(a) & U64.ofI64(b))
def Nx.ior(a: I64, b: I64): I64 = I64.ofU64(U64.ofI64(a) | U64.ofI64(b))
def Nx.ixor(a: I64, b: I64): I64 = I64.ofU64(U64.ofI64(a) ^ U64.ofI64(b))

// a NUL byte in s, in s[i, e) (the lexer: a NUL inside a token); a sorts before b by bytes (memcmp, then the length)
def Nx.hasNul(s: Str): Bool = Str.has(s, 0, 0, Str.len(s))
def Nx.lxAnyNul(s: Str, i: I64, e: I64): Bool = Str.has(s, 0, i, e)
def Nx.strLess(a: Str, b: Str): Bool = Str.less(a, b)

// the decimal integer at the start of s as strtoll reads it, with no leading white space: a sign, digits up to the first
// other byte. acc holds minus the value read so far, so that the minimum fits
def Nx.intNeg(s: Str): Bool = Str.at(s, 0) == 45
def Nx.intFirst(s: Str): I64 = if Str.at(s, 0) == 45 || Str.at(s, 0) == 43 then 1 else 0

// the decimal digits of s do not fit an I64 (Nix: "invalid integer"; strtoll's ERANGE). 18 bytes or fewer hold at most
// 18 digits, below 10^18 < 2^63: they never overflow. One more digit d overflows when acc * 10 - d < MIN, that is
// acc < MIN / 10 or (acc = MIN / 10 and d > 8)
def Nx.intOverflows(s: Str): Bool = Str.len(s) > 18 && Nx.intOv(s, Nx.intFirst(s), Nx.intNeg(s), 0)
def Nx.intOv(s: Str, i: I64, neg: Bool, acc: I64): Bool =
  val d = Str.at(s, i) - 48
  if d < 0 || d > 9 then !neg && acc == Nx.iMin()
  else if acc < Nx.iMin() / 10 || (acc == Nx.iMin() / 10 && d > 8) then true
  else Nx.intOv(s, i + 1, neg, acc * 10 - d)

// the value of the decimal digits of s; call Nx.intOverflows first (an overflowing value wraps)
def Nx.intValue(s: Str): I64 = Nx.intVal(s, Nx.intFirst(s), Nx.intNeg(s), 0)
def Nx.intVal(s: Str, i: I64, neg: Bool, acc: I64): I64 =
  val d = Str.at(s, i) - 48
  if d < 0 || d > 9 then (if neg then acc else Nx.isub(0, acc)) else Nx.intVal(s, i + 1, neg, Nx.isub(Nx.imul(acc, 10), d))
