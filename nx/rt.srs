extern def Nx.sbAdd(b: Ptr, s: Str): Unit
// the bytes of b, the builder's last use: its buffer becomes the string (cut to size) and b is left empty, so no
// builder outlives its string (the scratch builder keeps its buffer and gives a copy)
extern def Nx.sbGet(b: Ptr): Str
extern def Nx.sbScratch(): Ptr
extern def Nx.sbView(b: Ptr): Str
// an ATerm string: sbAddQ quoted as it is, sbAddEsc quoted with " \ newline CR tab escaped
extern def Nx.sbAddQ(b: Ptr, s: Str): Unit
extern def Nx.sbAddEsc(b: Ptr, s: Str): Unit
extern def Nx.escStr(s: Str): Str
