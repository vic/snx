// snx: the command line. `snx parse FILE` answers as nix-conformance SPEC.md "parse": `ok TREE` or `error LINE:COL`,
// with FILE read as /case/input.nix and $HOME as /home/case. `snx check FILE`: exit 0 iff FILE parses and has no
// undefined variable. `snx eval FILE [FLAG...]`: the value as `nix-instantiate --eval --strict FILE` prints it, exit 1
// on an error (its message on stderr). FILE of check and eval is an absolute path. `snx wire SOCKET OP ARG...`: SPEC.md
// "wire", a daemon client (nx/wire.srs). Exit 3 = an operation or flag snx does not have yet.

enum Nx.Op:
  case Nx.OpParse
  case Nx.OpNar
  case Nx.OpDrv
  case Nx.OpCheck
  case Nx.OpEval
  case Nx.OpEvalXml
  case Nx.OpFlake
  case Nx.OpUnknown

def Nx.op(s: Str): Nx.Op =
  if Str.eq(s, "parse") then Nx.OpParse
  else if Str.eq(s, "nar") then Nx.OpNar
  else if Str.eq(s, "drv") then Nx.OpDrv
  else if Str.eq(s, "check") then Nx.OpCheck
  else if Str.eq(s, "eval") then Nx.OpEval
  else if Str.eq(s, "eval-xml") then Nx.OpEvalXml
  else if Str.eq(s, "flake") then Nx.OpFlake
  else Nx.OpUnknown

def Nx.answerParse(src: Str): I64 =
  Nx.parse(src, "/case", "/home/case") match
    case Nx.Parsed(e) =>
      Console.print("ok ")
      Nx.printTree(e)
      Console.print("\n")
      0
    case Nx.ParseBadNoPos =>
      Console.print("error 0:0\n")
      0
    case Nx.ParseBad(p) =>
      Nx.lineCol(src, p) match
        case Nx.LineCol(l, c) =>
          Console.print("error ")
          Console.printI64(l)
          Console.print(":")
          Console.printI64(c)
          Console.print("\n")
          0

// SPEC.md "nar": `ok CONSUMED SHA256` or `error`
def Nx.answerNar(src: Str): I64 =
  Nx.narCheck(src) match
    case Nx.NarOk(n, sha) =>
      Console.print("ok ")
      Console.printI64(n)
      Console.print(" ")
      Console.print(sha)
      Console.print("\n")
      0
    case Nx.NarBad =>
      Console.print("error\n")
      0

// SPEC.md "drv": `ok DRVPATH SHA256` or `error`; the name comes from the file name
def Nx.answerDrv(path: Str, src: Str): I64 =
  Nx.drvParse(src, Nx.drvFileName(path)) match
    case Nx.DrvOk(d) =>
      val sha = Nx.drvHash(d)
      Console.print("ok ")
      Console.print(Nx.drvTextPath(d, sha))
      Console.print(" ")
      Console.print(Nx.b16(sha))
      Console.print("\n")
      0
    case Nx.DrvBad =>
      Console.print("error\n")
      0

def Nx.printPos(src: Str, p: I64): Unit = Nx.lineCol(src, p) match
  case Nx.LineCol(l, c) =>
    Console.eprintI64(l)
    Console.eprint(":")
    Console.eprintI64(c)

def Nx.answerCheck(path: Str, src: Str): I64 =
  Nx.parse(src, Nx.dirName(path), Nx.getEnv("HOME")) match
    case Nx.Parsed(e) => Nx.compile(e, path, src) match
      case Nx.Undefined(p, name) =>
        Console.eprint("error: undefined variable '")
        Console.eprint(name)
        Console.eprint("' at ")
        Nx.printPos(src, p)
        Console.eprint("\n")
        1
      case Nx.Compiled(_) => 0
    case _ =>
      Console.eprint("error: syntax error\n")
      1

def Nx.hasSub(s: Str, w: Str, i: I64): Bool =
  if i + Str.len(w) > Str.len(s) then false
  else if Str.eq(Str.slice(s, i, i + Str.len(w)), w) then true
  else Nx.hasSub(s, w, i + 1)

// the nix-instantiate flags snx knows (the rest exit 3): --eval and --strict (eval is always strict), --no-show-trace,
// --extra-experimental-features X (only parse-toml-timestamps changes anything yet), --max-call-depth N
def Nx.flagsOk(i: I64): Bool =
  if i >= Args.count() then true
  else
    val f = Args.at(i)
    if Str.eq(f, "--eval") || Str.eq(f, "--strict") || Str.eq(f, "--no-show-trace") then Nx.flagsOk(i + 1)
    else if Str.eq(f, "--extra-experimental-features") then
      if i + 1 < Args.count() && Nx.hasSub(Args.at(i + 1), "parse-toml-timestamps", 0) then Nx.aseti(Nx.globals(), Nx.gTimestamps(), 1) else ()
      Nx.flagsOk(i + 2)
    else if Str.eq(f, "-I") && i + 1 < Args.count() then
      Nx.inclAdd(Args.at(i + 1))
      Nx.flagsOk(i + 2)
    else if Str.eq(f, "--max-call-depth") && i + 1 < Args.count() then
      Nx.aseti(Nx.globals(), Nx.gMaxDepth(), Nx.intValue(Args.at(i + 1)))
      Nx.flagsOk(i + 2)
    else if Str.eq(f, "--impure") then Nx.flagsOk(i + 1)
    else if (Str.eq(f, "-A") || Str.eq(f, "--attr")) && i + 1 < Args.count() then Nx.flagsOk(i + 2)
    else if (Str.eq(f, "--arg") || Str.eq(f, "--argstr")) && i + 2 < Args.count() then Nx.flagsOk(i + 3)
    else if Str.eq(f, "--lint-absolute-path-literals") && i + 1 < Args.count() then Nx.lintSet(1, Args.at(i + 1)) && Nx.flagsOk(i + 2)
    else if Str.eq(f, "--lint-short-path-literals") && i + 1 < Args.count() then Nx.lintSet(4, Args.at(i + 1)) && Nx.flagsOk(i + 2)
    else if Str.eq(f, "--lint-url-literals") && i + 1 < Args.count() then Nx.lintSet(16, Args.at(i + 1)) && Nx.flagsOk(i + 2)
    else false

// the lint at `unit` of Nx.gLint set to warn or fatal; false for a mode snx does not know. A warning goes to stderr (Nx.lintWarn)
def Nx.lintSet(unit: I64, mode: Str): Bool =
  val g = Nx.globals()
  if Str.eq(mode, "warn") then
    Nx.aseti(g, Nx.gLint(), Nx.ageti(g, Nx.gLint()) + unit)
    true
  else if Str.eq(mode, "fatal") then
    Nx.aseti(g, Nx.gLint(), Nx.ageti(g, Nx.gLint()) + 2 * unit)
    true
  else false

// ---- auto arguments (nix-instantiate.cc, attr-path.cc findAlongAttrPath, get-drvs autoCallFunction) --------------------
// --arg/--argstr/-A are done by evaluating a wrapper expression around `import FILE`.
// shortcut: the 2nd and later -A are refused (exit 3); upgrade by running the wrapper once per -A

// the flag `f` among Args from i on, counted
def Nx.flagCount(i: I64, f: Str, g: Str): I64 =
  if i >= Args.count() then 0
  else (if Str.eq(Args.at(i), f) || Str.eq(Args.at(i), g) then 1 else 0) + Nx.flagCount(i + 1, f, g)

def Nx.hasAuto(i: I64): Bool =
  if i >= Args.count() then false
  else if Str.eq(Args.at(i), "--arg") || Str.eq(Args.at(i), "--argstr") || Str.eq(Args.at(i), "-A") || Str.eq(Args.at(i), "--attr") then true
  else Nx.hasAuto(i + 1)

// s as a Nix string literal
def Nx.nixStr(s: Str): Str =
  val sb = Nx.sbNew()
  Nx.sbAdd(sb, "\"")
  var i = 0
  while i < Str.len(s) do
    val c = Str.at(s, i)
    if c == '"' || c == '\\' || c == '$' then Nx.sbAdd(sb, "\\") else ()
    if c == '\n' then Nx.sbAdd(sb, "\\n") else Nx.sbAdd(sb, Nx.byte(c))
    i = i + 1
  Nx.sbAdd(sb, "\"")
  Nx.sbGet(sb)

// the `name = value;` bindings of the --arg and --argstr flags
def Nx.autoBinds(i: I64, sb: Ptr): Unit =
  if i < Args.count() then
    val f = Args.at(i)
    if Str.eq(f, "--arg") then
      Nx.sbAdd(sb, Nx.nixStr(Args.at(i + 1)))
      Nx.sbAdd(sb, " = (")
      Nx.sbAdd(sb, Args.at(i + 2))
      Nx.sbAdd(sb, "\n);\n")
      Nx.autoBinds(i + 3, sb)
    else if Str.eq(f, "--argstr") then
      Nx.sbAdd(sb, Nx.nixStr(Args.at(i + 1)))
      Nx.sbAdd(sb, " = ")
      Nx.sbAdd(sb, Nx.nixStr(Args.at(i + 2)))
      Nx.sbAdd(sb, ";\n")
      Nx.autoBinds(i + 3, sb)
    else Nx.autoBinds(i + 1, sb)
  else ()

// the attribute path of -A (a dotted name): each component selected after an auto call
def Nx.autoSel(acc: Str, p: Str, b: I64, i: I64): Str =
  if i >= Str.len(p) then (if b < i then Nx.autoStep(acc, Str.slice(p, b, i)) else acc)
  else if Str.at(p, i) == '.' then Nx.autoSel(if b < i then Nx.autoStep(acc, Str.slice(p, b, i)) else acc, p, i + 1, i + 1)
  else Nx.autoSel(acc, p, b, i + 1)

def Nx.autoStep(acc: Str, k: Str): Str = Nx.cat(Nx.cat(Nx.cat(Nx.cat("(__s (__auto ", acc), ") "), Nx.nixStr(k)), ")")

def Nx.autoPath(i: I64): Str =
  if i >= Args.count() then ""
  else if (Str.eq(Args.at(i), "-A") || Str.eq(Args.at(i), "--attr")) && i + 1 < Args.count() then Args.at(i + 1)
  else Nx.autoPath(i + 1)

def Nx.autoSrc(path: Str): Str =
  val sb = Nx.sbNew()
  Nx.sbAdd(sb, "let\n__args = {\n")
  Nx.autoBinds(3, sb)
  Nx.sbAdd(sb, "};\n__auto = f: if __snxHasFormals f then f (builtins.intersectAttrs (builtins.functionArgs f) __args) else f;\n")
  Nx.sbAdd(sb, "__s = v: k: if builtins.isList v && builtins.match \"[0-9]+\" k != null then builtins.elemAt v (builtins.fromJSON k) else v.${k};\nin __auto ")
  val root = Nx.cat(Nx.cat("(import (builtins.toPath ", Nx.nixStr(path)), "))")
  Nx.sbAdd(sb, Nx.autoSel(root, Nx.autoPath(3), 0, 0))
  Nx.sbGet(sb)

// the value of the file, through the auto-argument wrapper when a flag asks for it
def Nx.evalTop(path: Str): Nx.Val =
  if !Nx.hasAuto(3) then Nx.importFile(path)
  else
    val src = Nx.autoSrc(path)
    val b = Nx.baseEnv() match
      case _ => 0
    Nx.loadFile(src, Nx.getEnv("PWD"), Nx.getEnv("HOME"), "(auto arguments)") match
      case Nx.Loaded(code) => Nx.force(Nx.lazy(Nx.noFrame(), code))
      case Nx.LoadUndefined(_, name) => Nx.VErr(Nx.KOther, Nx.cat(Nx.cat("undefined variable '", name), "'"))
      case Nx.LoadBad => Nx.VErr(Nx.KOther, "syntax error in an --arg expression")
      case Nx.LoadFuel(n) => Nx.VErr(Nx.KOther, Nx.loadFuelMsg("(auto arguments)", n))

def Nx.answerEval(path: Str): I64 =
  if !Nx.flagsOk(3) || Nx.flagCount(3, "-A", "--attr") > 1 then 3
  else
    val v = Nx.evalTop(path)
    val r = if Nx.isErr(v) then v else Nx.deepForce(v, Nx.seenNew())
    r match
      case Nx.VErr(_, msg) =>
        Console.eprint("error: ")
        Console.eprint(msg)
        Console.eprint("\n")
        1
      case _ =>
        Nx.printTop(v)
        Console.print("\n")
        0

// `snx eval-xml FILE`: nix-instantiate --eval --strict --xml --no-location (value-to-xml.cc)
def Nx.answerEvalXml(path: Str): I64 =
  if !Nx.flagsOk(3) || Nx.flagCount(3, "-A", "--attr") > 1 then 3
  else
    val v = Nx.evalTop(path)
    val r = if Nx.isErr(v) then v else Nx.xmlDoc(v)
    r match
      case Nx.VErr(_, msg) =>
        Console.eprint("error: ")
        Console.eprint(msg)
        Console.eprint("\n")
        1
      case Nx.VStr(s, _) =>
        Console.print(s)
        0
      case _ => 1

// `snx flake FILE`: SPEC.md "flake", output `result` of the flake FILE/../flake.nix as JSON (b_flake.srs)
def Nx.answerFlake(path: Str): I64 =
  val f = Nx.importFile(Nx.cat(Nx.corePrefix(), "flake.nix"))
  val r = if Nx.isErr(f) then f else Nx.apply(f, Nx.cell(Nx.VStr(Nx.dirName(path), Coll.Nil)))
  r match
    case Nx.VErr(_, msg) =>
      Console.eprint("error: ")
      Console.eprint(msg)
      Console.eprint("\n")
      1
    case Nx.VStr(s, _) =>
      Console.print(s)
      Console.print("\n")
      0
    case _ => 1

// SNX_CACHE=<dir> (rt/snx_trace.c): -1 = evaluate, else the exit code of a stored run whose output was just written;
// cacheEnd stores a recorded run that may be stored, and gives back its code
extern def Nx.cacheBegin {r: Region} <r: Open> (): I64
extern def Nx.cacheEnd(code: I64): I64

// the replay reads its files into a Region of its own, gone when it ends
def Nx.cacheScratch(): I64 =
  handle q = Srs.Arena()
  Nx.cacheBegin()

def main(): I64 =
  handle r = Srs.Arena()
  handle c = Srs.Console()
  handle a = Srs.Args()
  handle f = Srs.Files()
  handle n = Srs.Net()
  val hit = Nx.cacheScratch()
  if hit >= 0 then hit else Nx.cacheEnd(Nx.run())

def Nx.run(): I64 =
  if Args.count() < 3 then
    Console.eprint("usage: snx parse|nar|drv|check|eval FILE\n")
    2
  else if Str.eq(Args.at(1), "wire") then Nx.answerWire()
  else
    val src = Files.read(Args.at(2))
    // the file argument relative to the working directory, as every later import sees it (canonPath takes a path as absolute)
    val path = Nx.absOf(Args.at(2))
    if Str.len(src) < 0 then
      Console.eprint("snx: cannot read the file\n")
      2
    else
      Nx.op(Args.at(1)) match
        case Nx.OpParse => Nx.answerParse(src)
        case Nx.OpNar => Nx.answerNar(src)
        case Nx.OpDrv => Nx.answerDrv(path, src)
        case Nx.OpCheck => Nx.answerCheck(path, src)
        case Nx.OpEval => Nx.answerEval(path)
        case Nx.OpEvalXml => Nx.answerEvalXml(path)
        case Nx.OpFlake => Nx.answerFlake(path)
        case Nx.OpUnknown => 3
