// probe output only (SNX_PROBE bit 2, rt/snx_rt.c Nx__trBusy): a short shape of a Nx.Code, d levels deep, for the
// chain of thunks being forced when one is re-entered

def Nx.cdesc(c: Nx.Code, d: I64): Str =
  if d == 0 then "…"
  else c match
    case Nx.CConst(v, _) => v match
      case Nx.VPath(s) => s
      case Nx.VStr(s, _) => Nx.cat(Nx.cat("\"", s), "\"")
      case _ => "const"
    case Nx.CLocal(up, i) => Nx.cat(Nx.cat(Nx.cat("v", Nx.decStr(up)), "."), Nx.decStr(i))
    case Nx.CWithVar(_, _, name) => Nx.cat("w:", name)
    case Nx.CCell(_) => "base"
    case Nx.CCurPos(file, line, _) => Nx.cat(Nx.cat(file, ":"), Nx.decStr(line))
    case Nx.CStr(s) => Nx.cat(Nx.cat("\"", s), "\"")
    case Nx.CPath(s) => s
    case Nx.CConcat(_, n, _) => "concat"
    case Nx.CList(n, _) => "[..]"
    case Nx.CAttrs(n, syms, _, _) => Nx.cat("{", Nx.cat(Nx.symsDesc(syms, 0, n), "}"))
    case Nx.CRecAttrs(n, syms, _, _) => Nx.cat("rec{", Nx.cat(Nx.symsDesc(syms, 0, n), "}"))
    case Nx.CLet(_, _, body) => Nx.cat("let..in ", Nx.cdesc(body, d - 1))
    case Nx.CWith(a, body) => Nx.cat(Nx.cat(Nx.cat("with ", Nx.cdesc(a, d - 1)), "; "), Nx.cdesc(body, d - 1))
    case Nx.CLam(_, _, _, _, _, _, name) => Nx.cat("lam ", name)
    case Nx.CLamArg(_, name) => Nx.cat("lam ", name)
    case Nx.CCall(f, n, args) => Nx.cat(Nx.cat(Nx.cat("(", Nx.cdesc(f, d - 1)), Nx.argsDesc(args, 0, n, d - 1)), ")")
    case Nx.CPrimCall(id, n, args) => Nx.cat(Nx.cat(Nx.cat("(prim", Nx.decStr(id)), Nx.argsDesc(args, 0, n, d - 1)), ")")
    case Nx.CSelect(e, path, _) => Nx.cat(Nx.cdesc(e, d - 1), Nx.pathDesc(path))
    case Nx.CHas(e, path) => Nx.cat(Nx.cat(Nx.cdesc(e, d - 1), " ?"), Nx.pathDesc(path))
    case Nx.CIf(cnd, _, _) => Nx.cat("if ", Nx.cdesc(cnd, d - 1))
    case Nx.CAssert(cnd, _, _, p) => Nx.cat(Nx.cat("assert@", Nx.decStr(p)), Nx.cdesc(cnd, d - 1))
    case Nx.CNot(a) => Nx.cat("!", Nx.cdesc(a, d - 1))
    case Nx.CAnd(a, b) => Nx.cat(Nx.cat(Nx.cdesc(a, d - 1), " && "), Nx.cdesc(b, d - 1))
    case Nx.COr(a, b) => Nx.cat(Nx.cat(Nx.cdesc(a, d - 1), " || "), Nx.cdesc(b, d - 1))
    case Nx.CImpl(a, b) => Nx.cat(Nx.cat(Nx.cdesc(a, d - 1), " -> "), Nx.cdesc(b, d - 1))
    case Nx.CBin(_, a, b) => Nx.cat(Nx.cat(Nx.cdesc(a, d - 1), " <op> "), Nx.cdesc(b, d - 1))
    case Nx.CAppSlots(n) => "appSlots"
    case Nx.CNum(_, a, b, _) => Nx.cat(Nx.cat(Nx.cdesc(a, d - 1), " <num> "), Nx.cdesc(b, d - 1))
    case Nx.CApp1(_) => "app1"

def Nx.decStr(n: I64): Str = if n < 10 then Nx.byte('0' + n) else Nx.cat(Nx.decStr(n / 10), Nx.byte('0' + n % 10))

def Nx.symsDesc(syms: Ptr, i: I64, n: I64): Str =
  if i == n || i == 6 then (if i < n then " …" else "")
  else Nx.cat(Nx.cat(" ", Nx.symName(Nx.ageti(syms, i))), Nx.symsDesc(syms, i + 1, n))

def Nx.argsDesc(args: Ptr, i: I64, n: I64, d: I64): Str =
  if i == n then "" else Nx.cat(Nx.cat(" ", Nx.cdesc(Nx.aget[Nx.Code](args, i), d)), Nx.argsDesc(args, i + 1, n, d))

def Nx.pathDesc(path: Coll.List[Nx.CKey]): Str = path match
  case Coll.Nil => ""
  case Coll.Cons(k, rest) =>
    val s = k match
      case Nx.KSym(sym) => Nx.symName(sym)
      case Nx.KDyn(_) => "${..}"
    Nx.cat(Nx.cat(".", s), Nx.pathDesc(rest))

// SNX_RELSEQ's release (rt/snx_rt.c Nx__relProbe gave hit = 1): the lambda whose call it ends and the force stack
def Nx.relDump(hit: I64, code: Nx.Code): Unit =
  if hit == 1 then
    Nx.eprint(Nx.cat(Nx.cat("snx-probe: release by a call of ", Nx.cdesc(Nx.lamBody(code), 6)), "\n"))
    Nx.trDump(0, Nx.trTop())
  else ()

// the chain printed by rt/snx_rt.c Nx__trBusy, from entry i to the top of the force stack
def Nx.trDump(i: I64, top: I64): Unit =
  if i < top then
    val s = Nx.trSymAt(i)
    val name = if s >= 0 then Nx.symName(s) else "-"
    Nx.eprint(Nx.cat(Nx.cat(Nx.cat(Nx.cat(Nx.cat(Nx.decStr(i), " "), name), "  "), Nx.cdesc(Nx.aget[Nx.Code](Nx.trCell(i), 2), 4)), "\n"))
    Nx.trDump(i + 1, top)
  else ()

def Nx.lamBody(c: Nx.Code): Nx.Code = c match
  case Nx.CLam(_, _, _, _, _, body, _) => body
  case Nx.CLamArg(body, _) => body
  case _ => c
