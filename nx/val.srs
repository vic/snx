// snx values (vic/notes/20261110T1400--eval-core-design__design_eval.md). A cell (Nx.cell) is one word that holds a
// Nx.Val, as Nix's Value: forcing a thunk writes the result into its cell. Frames, sets and lists hold cell pointers, as
// Nix's Env, Bindings and lists hold Value*: a variable in a lazy position passes its cell on, unforced and unshared by
// copy, and «repeated» compares lists by cell (print-ambiguous.cc:49) and sets by their Nx.VAttrs object (:33).
// Only cells hold Nx.VBusy; Nx.VPending is what Nx.peek reads in a thunk not run yet.

// why an evaluation failed; tryEval catches Nx.KThrow and Nx.KAssert only
enum Nx.ErrKind:
  case Nx.KThrow
  case Nx.KAssert
  case Nx.KAbort
  case Nx.KType
  case Nx.KMissing
  case Nx.KInfRec
  case Nx.KOther

// an element of a string's context (NixStringContextElem): a store path (Opaque), a .drv with its closure and every
// output (DrvDeep, the context of a drvPath), or one output of a derivation (Built). via = the outputs that lead from
// drv to the derivation that builds out (dynamic derivations, outputOf), newest first
enum Nx.Ctx:
  case Nx.XOpaque(path: Str)
  case Nx.XDeep(drv: Str)
  case Nx.XBuilt(drv: Str, via: Coll.List[Str], out: Str)

// a string's context: its elements, unsorted, maybe repeated (Coll.Nil = none)
enum Nx.Val:
  case Nx.VInt(n: I64)
  case Nx.VFloat(bits: I64)
  case Nx.VBool(b: Bool)
  case Nx.VNull
  case Nx.VStr(s: Str, ctx: Coll.List[Nx.Ctx])
  case Nx.VPath(s: Str)
  case Nx.VAttrs(n: I64, syms: Ptr, vals: Ptr)    // n names sorted by symbol id (Nx.intern), vals = their n cells
  case Nx.VUnion(k: I64, ls: Nx.Leaves)           // x // y kept as k (2..8) flat leaves, newest first (Nx.update): never empty
  case Nx.VList(n: I64, xs: Ptr)                  // n cells
  case Nx.VLam(env: Ptr, code: Nx.Code)           // code = a Nx.CLam
  case Nx.VPrim(id: I64, arity: I64)
  case Nx.VPrimApp(id: I64, arity: I64, args: Coll.List[Nx.Val])   // args newest first
  case Nx.VPending                                 // a thunk not run yet (Nx.peek): its cell holds env and code (Nx.lazy)
  case Nx.VBusy                                   // a thunk being forced: reading it is infinite recursion
  case Nx.VErr(kind: Nx.ErrKind, msg: Str)
  // a primop applied to fewer cells than its arity, newest first: the arguments stay lazy and keep their identity
  // (callFunction's tPrimOpApp chain holds Value*; builtins.elem id [ id ] is true by eqValues' pointer test)
  case Nx.VPrimPart(id: I64, arity: I64, args: Coll.List[Ptr])

// a parameter pattern after scope resolution: slot i of the call frame gets formal i (sorted by symbol id)
enum Nx.CFormal:
  case Nx.CFm(sym: I64, dflt: Coll.Option[Nx.Code])

// the operators that take two evaluated operands
enum Nx.BinOp:
  case Nx.OEq
  case Nx.ONe
  case Nx.OUpdate
  case Nx.OListConcat

// Nx.Expr after scope resolution (nx/compile.srs): every variable is a frame walk, a with lookup or a builtin
enum Nx.Code:
  case Nx.CConst(v: Nx.Val, c: Ptr)                       // c = a cell holding v, shared by every lazy use
  case Nx.CLocal(up: I64, i: I64)                         // frame up levels out, slot i (slot 0 = parent frame)
  case Nx.CWithVar(sym: I64, ups: Coll.List[I64], name: Str)   // frame levels to each enclosing with frame, innermost first
  case Nx.CCell(c: Ptr)                                   // a base env name (builtins, true, map, ...): its cell
  case Nx.CCurPos(file: Str, line: I64, col: I64)
  case Nx.CStr(s: Str)
  case Nx.CPath(s: Str)
  case Nx.CConcat(forceStr: Bool, n: I64, parts: Ptr)     // parts = n Nx.Code
  case Nx.CList(n: I64, xs: Ptr)                          // xs = n Nx.Code
  case Nx.CAttrs(n: I64, syms: Ptr, vals: Ptr, dyn: Coll.List[Nx.CDyn])               // vals = n Nx.Code, in the current frame
  case Nx.CRecAttrs(n: I64, syms: Ptr, vals: Ptr, dyn: Coll.List[Nx.CDyn])            // vals in a new frame of n slots
  case Nx.CLet(n: I64, vals: Ptr, body: Nx.Code)          // new frame of n slots, vals in it, body in it
  case Nx.CWith(a: Nx.Code, body: Nx.Code)                // new frame of 1 slot: the set (forced on first lookup)
  case Nx.CLam(arg: Bool, nformals: I64, formals: Ptr, ellipsis: Bool, nslots: I64, body: Nx.Code, name: Str)
  case Nx.CCall(f: Nx.Code, n: I64, args: Ptr)
  case Nx.CPrimCall(id: I64, n: I64, args: Ptr)           // a base env primop called with exactly its arity
  case Nx.CNum(op: Nx.NumOp, a: Nx.Code, b: Nx.Code, early: Bool)   // a numeric primop on two operands (n - 1, a < b); early = a call argument (Nx.thunk)
  case Nx.CSelect(e: Nx.Code, path: Coll.List[Nx.CKey], dflt: Coll.Option[Nx.Code])
  case Nx.CHas(e: Nx.Code, path: Coll.List[Nx.CKey])
  case Nx.CIf(c: Nx.Code, t: Nx.Code, e: Nx.Code)
  case Nx.CAssert(c: Nx.Code, b: Nx.Code, src: Str, p: I64)    // p = the offset in src: LINE:COL only when it fails
  case Nx.CNot(a: Nx.Code)
  case Nx.CAnd(a: Nx.Code, b: Nx.Code)
  case Nx.COr(a: Nx.Code, b: Nx.Code)
  case Nx.CImpl(a: Nx.Code, b: Nx.Code)
  case Nx.CBin(op: Nx.BinOp, a: Nx.Code, b: Nx.Code)
  case Nx.CLamArg(body: Nx.Code, name: Str)               // x: body, a frame of 1 slot: the argument (CLam = a pattern)
  case Nx.CAppSlots(n: I64)                               // slot 1 applied to slots 2..n+1 (the thunks of mapAttrs, ..)
  case Nx.CApp1(f: Ptr)                                   // cell f applied to the cell that is the env (a map or genList thunk: no frame)

enum Nx.CKey:
  case Nx.KSym(sym: I64)
  case Nx.KDyn(e: Nx.Code)

enum Nx.CDyn:
  case Nx.CDynBind(k: Nx.Code, v: Nx.Code)

// a new cell holding v, and its value (rt/snx_rt.c; cells, frames and arrays live until the run ends)
extern def Nx.cell(v: Nx.Val): Ptr
extern def Nx.get(c: Ptr): Nx.Val
extern def Nx.put(c: Ptr, v: Nx.Val): Unit
// a thunk: one allocation of 2 words, code (marked, until the value replaces it) and env; Nx.force runs it
extern def Nx.lazy(env: Ptr, code: Nx.Code): Ptr
extern def Nx.isLazy(c: Ptr): Bool
extern def Nx.lazyCode(c: Ptr): Nx.Code
// C arrays of words: a frame is slot 0 = parent frame, slots 1..n = cells
extern def Nx.arrNew(n: I64): Ptr
extern def Nx.aget [A: Type] (p: Ptr, i: I64): A
extern def Nx.aset [A: Type] (p: Ptr, i: I64, v: A): Unit
extern def Nx.ageti(p: Ptr, i: I64): I64
extern def Nx.aseti(p: Ptr, i: I64, v: I64): Unit
// the frame that slot 0 of frame f points to
extern def Nx.parent(f: Ptr): Ptr
// a frame of n value slots plus the parent link in slot 0
extern def Nx.frame(parent: Ptr, n: I64): Ptr
extern def Nx.noFrame(): Ptr
// the word arena as a stack (rt/snx_rt.c "stack discipline"): Nx.release(Nx.mark()) frees the words taken since
extern def Nx.mark(): Ptr
extern def Nx.release(m: Ptr): Unit
extern def Nx.leak(): Unit
// the address of a value (a layered set's identity for «repeated», nx/print.srs)
extern def Nx.valPtr(v: Nx.Val): Ptr
// the k leaves of a layered set, (n, syms, vals) word triples newest first in t, merged into out = (n, syms, vals)
extern def Nx.mergeLeaves(k: I64, t: Ptr, out: Ptr): Unit
// leaves 0..k-2 of t (all but the base) merged into out the same way
extern def Nx.mergeTop(k: I64, t: Ptr, out: Ptr): Unit

// symbols: ids in first-seen order (attribute order of == and of forcing is this order)
extern def Nx.intern(s: Str): I64
extern def Nx.symName(id: I64): Str
// the shared cell of a symbol's name as a string, Nx.noFrame() until Nx.nameCell makes it
extern def Nx.nameCellOf(id: I64): Ptr
extern def Nx.nameCellSet(id: I64, c: Ptr): Unit
// the index of sym in the n sorted ids at syms, or n when absent (binary search); use Nx.slotOf
extern def Nx.findSym(syms: Ptr, n: I64, sym: I64): I64

def Nx.slotOf(syms: Ptr, n: I64, sym: I64): Coll.Option[I64] =
  val i = Nx.findSym(syms, n, sym)
  if i < n then Coll.Some(i) else Coll.None

// the leaves of a layered set (Nx.VUnion), newest first: a name's value is the one in its newest leaf. Each leaf is a
// flat set as Nx.VAttrs holds it (n names sorted by symbol id, their cells); the oldest is the base
enum Nx.Leaves:
  case Nx.LBase(n: I64, syms: Ptr, vals: Ptr)
  case Nx.LOn(n: I64, syms: Ptr, vals: Ptr, under: Nx.Leaves)

// the primops that on numbers force their two operands and nothing else, and always end (Nx.CNum)
enum Nx.NumOp:
  case Nx.NAdd
  case Nx.NSub
  case Nx.NMul
  case Nx.NDiv
  case Nx.NLess
  case Nx.NAnd
  case Nx.NOr
  case Nx.NXor
